# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Never commit .env — it is in .gitignore.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Postgres with the pgvector extension.
#
# Local, via the bundled compose file (`docker compose up -d`):
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
#
# Managed alternatives — note these append parameters asyncpg rejects
# (sslmode, channel_binding); the app strips them for you, so paste the URL
# exactly as the provider gives it.
#   Neon:     postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.<ref>:pass@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Use the POOLED endpoint on both (`-pooler` for Neon, port 6543 for Supabase).
# The schema is created automatically on first boot.

DB_POOL_MIN=1
DB_POOL_MAX=5

# --- LLM (required) --------------------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Check your real rate limits at https://aistudio.google.com/rate-limit
#
# WARNING: Gemini's FREE tier uses your content to improve Google's products.
# Do not send confidential documents through it.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120

# --- Embeddings ------------------------------------------------------------
# Runs locally via sentence-transformers. No API key, no quota, no per-request
# cost — ingestion is limited by CPU rather than by a daily request cap.
#
# all-MiniLM-L6-v2 is 384-dimensional and ~90 MB. The vector dimension is read
# from the model at startup and used to build the pgvector column, so there is
# no dimension setting to get out of step.
#
# Switching to a model with a different output size requires re-ingesting:
#     DROP TABLE chunks;
# then restart and re-upload. Startup refuses to run on a mismatch.
#
# MEMORY: this pulls PyTorch — roughly 1 GB installed and 400-600 MB resident.
# It will not fit a 512 MB instance (e.g. Render's free tier).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8

# Cosine floor. Below this the app returns a grounded refusal WITHOUT calling
# the LLM — the main anti-hallucination lever. For all-MiniLM-L6-v2, unrelated
# text scores near 0.0-0.2 and a genuine match near 0.4-0.7.
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_CHARS=12000
HISTORY_TURNS=6

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=20

LOG_LEVEL=INFO

# --- Tests -----------------------------------------------------------------
# Optional. Set this to run the Postgres integration tests in test_store.py.
# It DROPS AND RECREATES the tables — point it at a scratch database.
# TEST_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_test
